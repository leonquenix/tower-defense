local currentLocale = "pt-br"

function Localization.setLocale(locale: string)
	if strings[locale] then
		currentLocale = locale
	end
end

function Localization.getLocale(): string
	return currentLocale
end

function Localization.get(key: string, params: { [string]: any }?): string
	local table_ = strings[currentLocale] or strings["pt-br"]
	local text = table_[key] or strings["pt-br"][key] or key
	if params then
		text = text:gsub("{(%w+)}", function(name: string): string
			local v = params[name]
			return if v == nil then "{" .. name .. "}" else tostring(v)
		end)
	end
	return text
end

function Localization.has(key: string): boolean
	return strings["pt-br"][key] ~= nil
end

function Localization.locales(): { string }
	return { "pt-br", "en" }
end

-- Verificação de cobertura entre idiomas (usada em testes)
function Localization.missingKeys(locale: string): { string }
	local missing = {}
	for key in pairs(strings["pt-br"]) do
		if strings[locale][key] == nil then
			table.insert(missing, key)
		end
	end
	table.sort(missing)
	return missing
end

return Localization
