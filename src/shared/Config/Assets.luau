local Assets = {}

Assets.entries = entries

function Assets.get(key: string): AssetEntry?
	return entries[key]
end

function Assets.image(key: string): string?
	local e = entries[key]
	return if e then e.image else nil
end

function Assets.towerKey(towerId: string, state: string): string
	return "tower_" .. towerId .. "_" .. state
end

function Assets.groundKey(mapId: string): string
	return "map_" .. mapId .. "_ground"
end

function Assets.enemyKey(defId: string, isBoss: boolean): string
	return (if isBoss then "boss_" else "enemy_") .. defId
end

function Assets.uploadedCount(): (number, number)
	local uploaded, total = 0, 0
	for _, e in pairs(entries) do
		total += 1
		if e.image then
			uploaded += 1
		end
	end
	return uploaded, total
end

return Assets
